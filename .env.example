# ─────────────────────────────────────────────────────────────
# SpaceX Invest — environment variables
# Copy to .env.local for local dev. In production (Vercel), set
# these in Project → Settings → Environment Variables instead.
# NEVER commit real values — .env*.local is gitignored.
# ─────────────────────────────────────────────────────────────

# Supabase project — Settings → API in the Supabase dashboard.
# Safe to expose to the browser (NEXT_PUBLIC_*): URL + anon key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only secret — used by API routes and the admin client.
# Bypasses Row Level Security. Must NEVER be exposed to the browser
# or prefixed NEXT_PUBLIC. Set as a server-side env var only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin seed credentials — used ONLY by scripts/seed-admin.mjs to
# create the admin console user. Not read by the running app.
# Not required in Vercel unless you run the seed script from CI.
ADMIN_EMAIL=admin@spacexinvest.co
ADMIN_PASSWORD=change-me-to-a-strong-password
